# ==============================================================================
# ENTERPRISE COPILOT CONFIGURATION (.env)
# ==============================================================================
# You can place this .env file in the PROJECT ROOT or inside the backend/ folder.
# The application automatically checks both locations!
# All services listed below have 100% FREE FOREVER tiers with NO credit card required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & LOCAL OLLAMA (100% Free & Local)
# ------------------------------------------------------------------------------
APP_NAME="Enterprise Agentic RAG Copilot"
APP_VERSION="1.0.0"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# LLM Provider: "groq" (Recommended ultra-fast cloud LPU) or "ollama" (100% local)
LLM_PROVIDER="groq"

# Groq Cloud LPU (Free Tier at https://console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# Ollama Endpoint (Used for nomic-embed-text embeddings and optional local LLM fallback):
# - For Local run: http://localhost:11434
# - For Docker container run: http://host.docker.internal:11434
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="qwen3:1.7b"
EMBEDDING_MODEL="nomic-embed-text"
TEMPERATURE=0.2
MAX_TOKENS=2048

# Frontend URL (CORS origin / Client API base)
NEXT_PUBLIC_API_URL="http://localhost:8000"


# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE (For Embeddings, Chunks & Semantic Retrieval)
# ------------------------------------------------------------------------------
# Option A: Local ChromaDB (Default - No setup needed, stored in ./data/chroma_db)
VECTOR_DB_TYPE="chroma"
CHROMA_PERSIST_DIR="./data/chroma_db"

# Option B: Qdrant Cloud (Recommended Free Cloud Vector DB - 1GB Forever Free)
# Sign up free at: https://cloud.qdrant.io (Zero credit card needed)
# VECTOR_DB_TYPE="qdrant"
# QDRANT_URL="https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333"
# QDRANT_API_KEY="your-qdrant-api-key-here"

# Option C: Pinecone (Free Serverless Starter - 100K vectors)
# Sign up free at: https://www.pinecone.io
# VECTOR_DB_TYPE="pinecone"
# PINECONE_API_KEY="pcsk_your_pinecone_key_here"
# PINECONE_INDEX="enterprise-copilot"


# ------------------------------------------------------------------------------
# 3. CONVERSATION & CHAT MEMORY DATABASE (Sessions & Message History)
# ------------------------------------------------------------------------------
# Option A: Local JSON Storage (Default - stored in ./data/sessions)
SESSIONS_DIR="./data/sessions"

# Option B: Neon Serverless PostgreSQL (Recommended Free Cloud SQL - 0.5 GB Free)
# Sign up free at: https://neon.tech (Instant serverless Postgres, zero credit card)
# DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Option C: Supabase PostgreSQL (Free Tier - 500 MB)
# Sign up free at: https://supabase.com
# DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Option D: MongoDB Atlas (Free M0 Sandbox - 512 MB Free)
# Sign up free at: https://www.mongodb.com/cloud/atlas
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/copilot_db?retryWrites=true&w=majority"


# ------------------------------------------------------------------------------
# 4. LIGHTNING-FAST SESSION CACHE (Optional In-Memory Cache)
# ------------------------------------------------------------------------------
# Upstash Redis (Free Tier - 10,000 commands/day)
# Sign up free at: https://upstash.com
# UPSTASH_REDIS_REST_URL="https://your-cluster.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"


# ------------------------------------------------------------------------------
# 5. DOCUMENT OBJECT STORAGE (For Uploaded PDFs, Word Docs, Text Files)
# ------------------------------------------------------------------------------
# Option A: Local Disk Directory (Default - stored in ./data/uploads)
UPLOAD_DIR="./data/uploads"

# Option B: Cloudflare R2 (Recommended Free S3-Compatible Cloud Storage - 10 GB Free, $0 Egress fees)
# Sign up free at: https://dash.cloudflare.com
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-access-key-id"
# R2_SECRET_ACCESS_KEY="your-secret-access-key"
# R2_BUCKET_NAME="copilot-documents"


# ------------------------------------------------------------------------------
# 6. RAG TUNING & SEARCH FALLBACK
# ------------------------------------------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35
ENABLE_WEB_SEARCH_FALLBACK=true
MAX_WEB_RESULTS=4
